{
  "name": "memdev",
  "version": "0.1.0",
  "private": true,
  "description": "A private memory layer for developers on the web.",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": ["backend"],
  "scripts": {
    "dev": "npm run dev --workspace @memdev/backend",
    "build": "npm run build --workspace @memdev/backend",
    "start": "npm run start --workspace @memdev/backend",
    "test": "npm run test --workspace @memdev/backend",
    "test:watch": "npm run test:watch --workspace @memdev/backend",
    "db:migrate": "npm run db:migrate --workspace @memdev/backend",
    "typecheck": "npm run typecheck --workspace @memdev/backend",
    "lint": "npm run lint --workspace @memdev/backend"
  },
  "license": "UNLICENSED"
}
