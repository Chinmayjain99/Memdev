{
  "name": "@memdev/backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/run.test.ts",
    "test:watch": "node --env-file-if-exists=.env --import tsx --test --watch tests/run.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/database/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.34.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
